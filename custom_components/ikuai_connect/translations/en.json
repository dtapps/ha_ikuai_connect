  "services": {
    "add_mac_rule": {
      "description": "Create a new MAC whitelist/blacklist rule in iKuai. After creation, the integration will automatically generate the corresponding switch entity.",
      "fields": {
        "device_id": {
          "description": "Select the router device to operate. Only needed when multiple routers are configured.",
          "name": "Target Device"
        },
        "expires": {
          "description": "Unix timestamp. The rule will automatically expire at this time. 0 means it never expires.",
          "name": "Expiration Timestamp"
        },
        "mac": {
          "description": "The physical MAC address of the terminal.",
          "name": "MAC Address"
        },
        "tagname": {
          "description": "The name displayed in the iKuai backend and Home Assistant.",
          "name": "Rule Name"
        }
      },
      "name": "Add MAC Access Control Rule"
    },
    "backup": {
      "description": "The system backup task has started. Please check the backup files in the background later.",
      "name": "System Backup"
    },
    "call_api_service": {
      "description": "Generic caller for any iKuai OpenAPI endpoint, used to fetch data not yet natively integrated or to perform actions.",
      "fields": {
        "device_id": {
          "description": "Select the router device to operate. Only needed when multiple routers are configured.",
          "name": "Target Device"
        },
        "method": {
          "description": "HTTP request method (dropdown). GET fetches data with params appended to the URL query string; POST/PUT/DELETE submit data or perform actions with params sent as the request body. Defaults to GET.",
          "name": "HTTP Method"
        },
        "params": {
          "description": "Parameters as JSON. For GET they are appended to the query string; for POST/PUT/DELETE they are sent as the request body.",
          "name": "Request Params (JSON)"
        },
        "path": {
          "description": "Endpoint path starting with /api/, e.g. /api/v4.0/monitoring/clients-online",
          "name": "API Path"
        },
        "return_raw": {
          "description": "When enabled, the data field contains the full response including code/message/results; when disabled, only the business data (results) is returned.",
          "name": "Return Raw Response"
        },
        "timeout": {
          "description": "Request timeout in seconds. Defaults to 15, maximum 120.",
          "name": "Timeout (seconds)"
        }
      },
      "name": "Custom API Call"
    },
    "check_upgrade": {
      "description": "Checking for new versions from the cloud. Please check the system logs shortly.",
      "name": "Check for Updates"
    },
    "delete_mac_rule": {
      "description": "Completely remove the specified MAC filtering rule. The corresponding Home Assistant switch entity will be automatically removed.",
      "fields": {
        "device_id": {
          "description": "Select the router device to operate. Only needed when multiple routers are configured.",
          "name": "Target Device"
        },
        "rule_id": {
          "description": "The unique numeric ID of the rule (visible in the entity attributes).",
          "name": "Rule ID"
        }
      },
      "name": "Delete MAC Access Control Rule"
    },
    "get_offline_history": {
      "description": "Retrieve the latest 20 offline records for terminals, measured in MB.",
      "fields": {
        "device_id": {
          "description": "Select the router device to query. Only needed when multiple routers are configured.",
          "name": "Target Device"
        }
      },
      "name": "Get Offline Terminal History"
    },
    "get_protocol_stats": {
      "description": "Retrieve protocol-based traffic statistics for the specified terminal over the last 24 hours (e.g., to determine whether the device was streaming video or downloading files).",
      "fields": {
        "device_id": {
          "description": "Select the router device to query. Only needed when multiple routers are configured.",
          "name": "Target Device"
        },
        "ip": {
          "description": "The terminal's IP address (optional; if omitted, the system will attempt to match automatically from cache).",
          "name": "IP Address"
        },
        "mac": {
          "description": "The terminal's MAC address.",
          "name": "MAC Address"
        }
      },
      "name": "Get Protocol Distribution"
    },
    "get_traffic_ranking": {
      "description": "Retrieve today's total traffic usage for all terminals, measured in MB.",
      "fields": {
        "device_id": {
          "description": "Select the router device to query. Only needed when multiple routers are configured.",
          "name": "Target Device"
        }
      },
      "name": "Get Today's Traffic Ranking"
    },
    "reboot": {
      "description": "The reboot command has been issued. iKuai will perform the reboot within 1 minute.",
      "name": "Reboot Router"
    },
    "start_upgrade": {
      "description": "The system upgrade command has been triggered. Do not power off or reboot the device.",
      "name": "Firmware Upgrade"
    }
